# Deriv 5-Tick UP/DOWN Engine - Environment Configuration Template
# Copy this file to .env and configure your settings.
# NOTE: Real-money trading is permanently disabled in this project.
# Never commit real API tokens to version control.

# --- Deriv WebSocket API Settings ---
DERIV_APP_ID=1089
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_FALLBACK_WS_URL=wss://ws.derivws.com/websockets/v3

# --- Optional Demo Account Credentials (For Isolated Demo Settlement Verification Only) ---
# Used ONLY when --enable-demo-execution is explicitly passed to contract_lifecycle.py
# Never used in research or standard paper trading modes.
DERIV_DEMO_TOKEN=

# --- Market & Contract Settings ---
DEFAULT_SYMBOL=R_75
DURATION_TICKS=5
DEFAULT_STAKE=2.0
CURRENCY=USD

# --- Live Data & Quote Polling ---
QUOTE_POLL_INTERVAL_SECONDS=2.0
MAX_QUOTE_AGE_SECONDS=60.0
TICK_GAP_THRESHOLD_SECONDS=3.0
LIVE_TICK_FLUSH_INTERVAL_TICKS=25

# --- Storage Paths ---
QUOTES_DB_PATH=data/quotes.db
FORWARD_PREDICTIONS_DB_PATH=data/forward_predictions.db
SESSIONS_DB_PATH=data/sessions.db
RISK_STATE_DB_PATH=data/risk_state.db
LIVE_TICKS_DIR=data/
REPORTS_DIR=reports

# --- Safety & Execution Protection ---
# Real-money execution is permanently locked to True
LIVE_EXECUTION_DISABLED=True
ENABLE_DEMO_EXECUTION=False

